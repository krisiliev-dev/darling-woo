# Copy to /srv/darling/prod/.env on the server and fill in.
# Generate passwords ON the box:  openssl rand -base64 30 | tr -d '/+=' | head -c 32
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=darling_wp
MYSQL_USER=darling_wp
MYSQL_PASSWORD=

# Site URL is env-driven on purpose: switching staging -> production is a config
# change + restart, NOT a `wp search-replace` database migration.
WP_HOME=https://staging.darlinghome.bg
WP_SITEURL=https://staging.darlinghome.bg
