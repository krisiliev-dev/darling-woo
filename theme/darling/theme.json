{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"palette": [
				{
					"slug": "cherry",
					"color": "#D42A3C",
					"name": "Череша"
				},
				{
					"slug": "cherry-deep",
					"color": "#B01F30",
					"name": "Тъмна череша"
				},
				{
					"slug": "honey",
					"color": "#E8A61B",
					"name": "Мед"
				},
				{
					"slug": "honey-dark",
					"color": "#C9891B",
					"name": "Тъмен мед"
				},
				{
					"slug": "cocoa",
					"color": "#3A1D20",
					"name": "Какао"
				},
				{
					"slug": "cream",
					"color": "#FFF6E9",
					"name": "Крем"
				},
				{
					"slug": "vanilla",
					"color": "#FFE9C9",
					"name": "Ванилия"
				},
				{
					"slug": "sand",
					"color": "#F2E3CC",
					"name": "Пясък"
				},
				{
					"slug": "white",
					"color": "#FFFFFF",
					"name": "Бяло"
				}
			]
		},
		"typography": {
			"fluid": {
				"minViewportWidth": "430px",
				"maxViewportWidth": "1280px"
			},
			"defaultFontSizes": false,
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Много малък",
					"size": "0.8125rem",
					"fluid": {
						"min": "0.8125rem",
						"max": "0.875rem"
					}
				},
				{
					"slug": "small",
					"name": "Малък",
					"size": "0.875rem",
					"fluid": {
						"min": "0.875rem",
						"max": "0.9375rem"
					}
				},
				{
					"slug": "medium",
					"name": "Основен",
					"size": "1rem",
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					}
				},
				{
					"slug": "large",
					"name": "Голям",
					"size": "1.125rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "section",
					"name": "Секция",
					"size": "1.3125rem",
					"fluid": {
						"min": "1.3125rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Заглавие",
					"size": "1.625rem",
					"fluid": {
						"min": "1.625rem",
						"max": "2.5rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Дисплей",
					"size": "2.25rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3.75rem"
					}
				}
			],
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "Inter, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-normal-400-700-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-normal-400-700-cyrillic.woff2"
							],
							"unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116"
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-normal-400-700-cyrillic-ext.woff2"
							],
							"unicodeRange": "U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F"
						}
					]
				},
				{
					"slug": "playfair-display",
					"name": "Playfair Display",
					"fontFamily": "\"Playfair Display\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Playfair Display",
							"fontStyle": "normal",
							"fontWeight": "400 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/playfair-display-normal-400-900-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Playfair Display",
							"fontStyle": "normal",
							"fontWeight": "400 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/playfair-display-normal-400-900-cyrillic.woff2"
							],
							"unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116"
						},
						{
							"fontFamily": "Playfair Display",
							"fontStyle": "italic",
							"fontWeight": "400 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/playfair-display-italic-400-900-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Playfair Display",
							"fontStyle": "italic",
							"fontWeight": "400 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/playfair-display-italic-400-900-cyrillic.woff2"
							],
							"unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116"
						}
					]
				}
			]
		},
		"layout": {
			"contentSize": "43rem",
			"wideSize": "90rem"
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"name": "3XS",
					"size": "clamp(0.25rem, 0.2184rem + 0.1176vw, 0.3125rem)"
				},
				{
					"slug": "30",
					"name": "2XS",
					"size": "clamp(0.5rem, 0.4368rem + 0.2353vw, 0.625rem)"
				},
				{
					"slug": "40",
					"name": "XS",
					"size": "clamp(0.75rem, 0.6551rem + 0.3529vw, 0.9375rem)"
				},
				{
					"slug": "50",
					"name": "S",
					"size": "clamp(1rem, 0.8735rem + 0.4706vw, 1.25rem)"
				},
				{
					"slug": "60",
					"name": "M",
					"size": "clamp(1.5rem, 1.3103rem + 0.7059vw, 1.875rem)"
				},
				{
					"slug": "70",
					"name": "L",
					"size": "clamp(2rem, 1.7471rem + 0.9412vw, 2.5rem)"
				},
				{
					"slug": "80",
					"name": "XL",
					"size": "clamp(3rem, 2.6206rem + 1.4118vw, 3.75rem)"
				},
				{
					"slug": "90",
					"name": "2XL",
					"size": "clamp(4rem, 3.4941rem + 1.8824vw, 5rem)"
				},
				{
					"slug": "100",
					"name": "3XL",
					"size": "clamp(6rem, 5.2412rem + 2.8235vw, 7.5rem)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--cream)",
			"text": "var(--wp--preset--color--cocoa)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65",
			"letterSpacing": "0"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--cherry-deep)"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--playfair-display)",
					"fontWeight": "500"
				}
			},
			"h1": {
				"color": {
					"text": "var(--wp--preset--color--honey-dark)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.18",
					"fontWeight": "600",
					"fontFamily": "var(--wp--preset--font-family--playfair-display)"
				}
			},
			"h2": {
				"color": {
					"text": "var(--wp--preset--color--honey-dark)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--section)",
					"lineHeight": "1.25",
					"fontWeight": "500",
					"fontFamily": "var(--wp--preset--font-family--playfair-display)"
				}
			},
			"h3": {
				"color": {
					"text": "var(--wp--preset--color--honey-dark)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.3",
					"fontWeight": "600",
					"fontFamily": "var(--wp--preset--font-family--inter)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--cherry)",
					"text": "#FFF6EE"
				},
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)"
				}
			}
		}
	}
}