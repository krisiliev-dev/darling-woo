{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "cherry",      "color": "#D42A3C", "name": "Череша" },
        { "slug": "cherry-deep", "color": "#B01F30", "name": "Тъмна череша" },
        { "slug": "honey",       "color": "#E8A61B", "name": "Мед" },
        { "slug": "honey-dark",  "color": "#C9891B", "name": "Тъмен мед" },
        { "slug": "cocoa",       "color": "#3A1D20", "name": "Какао" },
        { "slug": "cream",       "color": "#FFF6E9", "name": "Крем" },
        { "slug": "vanilla",     "color": "#FFE9C9", "name": "Ванилия" },
        { "slug": "sand",        "color": "#F2E3CC", "name": "Пясък" },
        { "slug": "white",       "color": "#FFFFFF", "name": "Бяло" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontSizes": [
        { "slug": "small",   "size": "0.875rem", "name": "Малък" },
        { "slug": "medium",  "size": "1rem",     "name": "Среден" },
        { "slug": "large",   "size": "1.375rem", "name": "Голям" },
        { "slug": "x-large", "size": "2rem",     "name": "Много голям" }
      ],
      "fontFamilies": [
        {
          "slug": "inter",
          "name": "Inter",
          "fontFamily": "Inter, -apple-system, \"Segoe UI\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/inter-normal-400-700-latin.woff2" ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/inter-normal-400-700-cyrillic.woff2" ],
              "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116"
            },
            {
              "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/inter-normal-400-700-cyrillic-ext.woff2" ],
              "unicodeRange": "U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F"
            }
          ]
        },
        {
          "slug": "playfair-display",
          "name": "Playfair Display",
          "fontFamily": "\"Playfair Display\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Playfair Display", "fontStyle": "normal", "fontWeight": "400 900", "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/playfair-display-normal-400-900-latin.woff2" ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Playfair Display", "fontStyle": "normal", "fontWeight": "400 900", "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/playfair-display-normal-400-900-cyrillic.woff2" ],
              "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116"
            },
            {
              "fontFamily": "Playfair Display", "fontStyle": "italic", "fontWeight": "400 900", "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/playfair-display-italic-400-900-latin.woff2" ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Playfair Display", "fontStyle": "italic", "fontWeight": "400 900", "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/playfair-display-italic-400-900-cyrillic.woff2" ],
              "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116"
            }
          ]
        }
      ]
    },
    "layout": { "contentSize": "820px", "wideSize": "1280px" }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--cream)", "text": "var(--wp--preset--color--cocoa)" },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "1rem",
      "lineHeight": "1.6"
    },
    "elements": {
      "link":   { "color": { "text": "var(--wp--preset--color--cherry-deep)" } },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--playfair-display)",
          "fontWeight": "500"
        }
      },
      "h1":     { "color": { "text": "var(--wp--preset--color--honey-dark)" } },
      "h2":     { "color": { "text": "var(--wp--preset--color--honey-dark)" } },
      "h3":     { "color": { "text": "var(--wp--preset--color--honey-dark)" } },
      "button": {
        "color":  { "background": "var(--wp--preset--color--cherry)", "text": "#FFF6EE" },
        "border": { "radius": "999px" },
        "typography": { "fontFamily": "var(--wp--preset--font-family--inter)" }
      }
    }
  }
}
